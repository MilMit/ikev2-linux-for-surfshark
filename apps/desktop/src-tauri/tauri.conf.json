{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MilMit Secure",
  "version": "0.1.0",
  "identifier": "net.milmit.secure",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MilMit Secure",
        "width": 430,
        "height": 760,
        "minWidth": 390,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
