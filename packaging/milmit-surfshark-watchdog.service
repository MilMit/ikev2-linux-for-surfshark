[Unit]
Description=MilMit Surfshark IKEv2 watchdog
After=NetworkManager.service strongswan.service strongswan-starter.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/lib/milmit-surfshark/milmit-surfshark-watchdog.sh
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/milmit-surfshark /var/lib/milmit-surfshark /var/log /etc/milmit-surfshark /etc/swanctl
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
